# Copier vers .env : cp .env.example .env
# Ne jamais committer .env
#
# DEV (défaut) : les valeurs ci-dessous suffisent.
# PROD : voir la section PROD en bas (DEBUG=False + valeurs à changer).

# Django
SECRET_KEY=django-insecure-CHANGE-MOI-en-prod-32-caracteres-minimum-abcdef123456
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL 16 OBLIGATOIRE — jamais SQLite
# Format : postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://grocery_user:grocery_pass_123@127.0.0.1:5432/grocery_db

# ------------------------------------------------------------------
# PROD : copier ce bloc dans .env et adapter
# ------------------------------------------------------------------
# SECRET_KEY=<50+ caractères aléatoires : python -c "import secrets; print(secrets.token_urlsafe(50))">
# DEBUG=False
# ALLOWED_HOSTS=ton-domaine.tn,www.ton-domaine.tn
# CSRF_TRUSTED_ORIGINS=https://ton-domaine.tn,https://www.ton-domaine.tn
# DATABASE_URL=postgres://USER:PASSWORD_FORT@127.0.0.1:5432/grocery_db
#
# Rappel : sans SECRET_KEY de production, le démarrage échoue (garde-fou
# dans config/settings.py). HTTPS + cookies sécurisés + HSTS activés
# automatiquement dès DEBUG=False.
